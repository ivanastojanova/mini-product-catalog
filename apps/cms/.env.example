DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Storefront base URL + shared secret used to call POST /api/revalidate
# on apps/web after a product write (webhook-style, see
# docs/adr/0002-webhook-based-revalidation.md).
WEB_APP_URL=http://localhost:3000
REVALIDATE_SECRET=replace-me-with-a-long-random-string
