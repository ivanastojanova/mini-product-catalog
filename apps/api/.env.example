PORT=4000
WEB_ORIGIN=http://localhost:3000
CMS_API_URL=http://localhost:3001

# Payments (Phase 5). The gateway is a separate app, see apps/gateway.
GATEWAY_URL=http://localhost:4100
# What the BROWSER uses to reach the gateway's pay page (differs from GATEWAY_URL behind a proxy).
GATEWAY_PUBLIC_URL=http://localhost:4100
# Must equal the gateway's values. Generate real ones with: openssl rand -hex 32
GATEWAY_API_KEY=replace-me-with-a-long-random-string
GATEWAY_WEBHOOK_SECRET=replace-me-with-a-long-random-string
