PORT=4100
DATABASE_URL=file:./gateway.db
# Must equal apps/api's values. Generate real ones with: openssl rand -hex 32
GATEWAY_API_KEY=replace-me-with-a-long-random-string
GATEWAY_WEBHOOK_SECRET=replace-me-with-a-long-random-string
# Where signed events are POSTed (apps/api).
WEBHOOK_URL=http://localhost:4000/webhooks/payments
# The only origin a payment's returnUrl may point at (apps/web).
ALLOWED_RETURN_ORIGIN=http://localhost:3000
# What the browser uses to reach this gateway.
GATEWAY_PUBLIC_URL=http://localhost:4100
